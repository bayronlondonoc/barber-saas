# ---------------------------------------------------------------------------
# Barber SaaS — configuración del servidor
# Copiá este archivo como .env y llená lo que vayas conectando.
# Sin llenar nada, todo funciona en local con WhatsApp y pagos SIMULADOS.
# ---------------------------------------------------------------------------

# Puerto y dirección pública (la que ven tus clientes; con https en producción)
PUERTO=8765
URL_PUBLICA=http://localhost:8765
ZONA_HORARIA=America/Bogota
ARCHIVO_DB=./datos/barbersaas.db
# NODE_ENV=production

# ¿Cualquiera puede crear una cuenta? (si/no)
REGISTRO_ABIERTO=si

# --- WhatsApp (API oficial de Meta · WhatsApp Cloud API) ---------------------
# WHATSAPP_PROVEEDOR=meta
# WHATSAPP_TOKEN=            # token permanente de un usuario del sistema
# WHATSAPP_PHONE_NUMBER_ID=  # ID del número que envía (cada barbería puede tener el suyo en Ajustes)
# WHATSAPP_WABA_ID=          # ID de la cuenta de WhatsApp Business (para registrar plantillas)
# WHATSAPP_APP_SECRET=       # secreto de la app de Meta: verifica que los avisos vienen de Meta
# WHATSAPP_VERIFY_TOKEN=     # una palabra que vos inventás y pegás también en Meta
# WHATSAPP_API_VERSION=v26.0
# WHATSAPP_IDIOMA=es
# BARBERIA_PRINCIPAL=        # slug de la barbería que recibe los mensajes si el número no está asignado

# --- Pagos de anticipos (Wompi) ----------------------------------------------
# Cada barbería puede poner sus propias llaves en Ajustes → Conexiones.
# Estas solo sirven como llaves por defecto (por ejemplo, para una sola barbería).
# PAGOS_PROVEEDOR=wompi
# WOMPI_LLAVE_PRIVADA=prv_test_xxxxxxxx
# WOMPI_SECRETO_EVENTOS=test_events_xxxxxxxx
